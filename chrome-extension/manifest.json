{
  "manifest_version": 3,
  "name": "Re信号 - YouTube暗号化・復号",
  "version": "1.1.3",
  "description": "YouTubeのRe信号を自動復号・色分け・非表示に切り替え。手動復号・暗号化・送信確認にも対応。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/zero-lily/Re-Cipher/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "action": {
    "default_title": "Re信号 暗号化・復号",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
